    {
      "id": "ec3576d7-1eb9-48ba-9216-00d6a3165de4",
      "name": "WhatsApp Inbound (POST)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        400
      ],
      "webhookId": "fe3d56cd-190c-441e-92ba-2b0cb296bfc0",
      "parameters": {
        "httpMethod": "POST",
